# ============================================================
# Laravel - .gitignore (compatible con Linux, macOS y Windows)
# ============================================================

# Dependencias (nunca deben estar en el repo)
/vendor/
/node_modules/

# Archivos de entorno (contienen secretos)
.env
.env.backup
.env.production
.env.local
.env.*.local

# Certificados SSL del servidor (generados por Certbot, no van en git)
deploy/nginx/ssl/*.pem
deploy/nginx/ssl/*.key
deploy/.env.production

# Archivos de Laravel generados en runtime
/public/hot
/public/storage
/storage/*.key
/storage/logs/
/storage/framework/cache/
/storage/framework/sessions/
/storage/framework/views/
/bootstrap/cache/

# Logs y caché
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.phpunit.result.cache
.php-cs-fixer.cache
phpstan.neon

# Archivos de sistema macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Archivos de sistema Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# Archivos de sistema Linux
*~
.nfs*

# IDEs y editores
.idea/
*.iml
*.iws
*.ipr
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.project
.classpath
.c9/
*.launch
.settings/
*.tmproj
.netbeans/

# Build / Vite
/public/build/

# Tests
.phpunit.cache/
coverage/