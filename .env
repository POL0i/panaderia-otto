# ============================================================
# .env de PRODUCCIÓN — Panadería Otto
# Copia esto a .env y rellena los valores
# ============================================================

APP_NAME="Panadería Otto"
APP_ENV=production
APP_KEY=                          # se genera con: php artisan key:generate
APP_DEBUG=false
APP_URL=https://panaderia-otto.shop

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_BO

LOG_CHANNEL=stack
LOG_LEVEL=error

# ── BASE DE DATOS ──────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=mysql                     # nombre del contenedor Docker
DB_PORT=3306
DB_DATABASE=panaderia_otto
DB_USERNAME=panaderia
DB_PASSWORD=e4GNir1RAABL3d6rLT3YciY9ABc6NsXQ
DB_ROOT_PASSWORD=cK8isenXUS79O1hdkGugbVFN8Fq6wSa

# ── CACHÉ Y SESIONES ───────────────────────────────────────
CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis

REDIS_HOST=redis                  # nombre del contenedor Docker
REDIS_PASSWORD=null
REDIS_PORT=6379

# ── CORREO ─────────────────────────────────────────────────
# Usando SMTP de correo.panaderia-otto.shop
MAIL_MAILER=smtp
MAIL_HOST=correo.panaderia-otto.shop
MAIL_PORT=587
MAIL_USERNAME=no-reply@panaderia-otto.shop
MAIL_PASSWORD=CONTRASEÑA_DEL_CORREO
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@panaderia-otto.shop
MAIL_FROM_NAME="Panadería Otto"

# Alternativa: usar Brevo/Mailtrap en lugar del servidor propio
# MAIL_MAILER=smtp
# MAIL_HOST=smtp-relay.brevo.com
# MAIL_PORT=587
# MAIL_USERNAME=tu_usuario_brevo
# MAIL_PASSWORD=tu_api_key_brevo
# MAIL_ENCRYPTION=tls

# ── VITE ───────────────────────────────────────────────────
VITE_APP_NAME="${APP_NAME}"
